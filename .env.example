# Copy these into Vercel → Project → Settings → Environment Variables.
# Website enquiries are emailed through Resend (https://resend.com).
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxx
# Inbox that receives enquiries (comma-separate for several)
ENQUIRY_TO=info@godswaycompany.com
# Sender on a domain verified in Resend. Until then, leave unset to use Resend's test sender.
ENQUIRY_FROM="Godsway Website <web@godswaycompany.com>"
